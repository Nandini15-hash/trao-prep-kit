# Copy to .env.local in apps/web (or set this in your deployment provider —
# e.g. Vercel's project environment variables).
#
# Next.js only inlines env vars prefixed NEXT_PUBLIC_ into the browser
# bundle; everything else here is server-only by convention, but this app
# has exactly one frontend env var.

# The deployed API's base URL (apps/api). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000
