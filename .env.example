# These are apps/api's env vars — copy this file to apps/api/.env (or set
# them in your deployment provider). The frontend (apps/web) has its own,
# much smaller, apps/web/.env.example.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# MongoDB Atlas free tier (M0) connection string
MONGODB_URI=mongodb://localhost:27017/trao_prep_kit

# --- Auth ---
# Random 32+ char secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Session cookie lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# --- LLM (Google Gemini, free tier) ---
# Create a key at https://aistudio.google.com/app/apikey — no billing required
# for the free tier, but per-minute token limits apply (see README).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Public discussion search (Tavily) ---
# Create a free key at https://app.tavily.com — 1,000 credits/month, no
# credit card. See README for why Tavily over Brave/Google CSE.
TAVILY_API_KEY=

# --- Crawler ---
# Max pages fetched per company site per kit
CRAWL_MAX_PAGES=8
# Per-request timeout in ms
CRAWL_TIMEOUT_MS=8000
# Delay between requests to the same host, in ms
CRAWL_RATE_LIMIT_MS=500
